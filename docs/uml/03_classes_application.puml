@startuml 03_classes_application
!include style.iuml
title GSB-CR — Diagramme de classes de l'application (architecture en couches, v0.8.0)
hide empty members
skinparam packageStyle rectangle
set separator none

package "GSB.CR.IHM" <<WinForms>> {
  class Program <<module>> {
    +Main(args : String[])
  }
  class FrmConnexion {
    +Utilisateur : UtilisateurConnecte
    +ChangementMotDePasseRequis : Boolean
  }
  class FrmChangementMotDePasse
  class FrmAccueil {
    +Deconnexion : Boolean
  }
  class TuileModule {
    +ModuleAssocie : ModuleApplication
  }
  class FrmMesComptesRendus {
    -Recharger(numero)
    -OuvrirRapport(numero)
  }
  class FrmCompteRendu {
    +NumeroEnregistre : Integer
    +EnregistreValide : Boolean
    -LireFormulaire()
    -Enregistrer(valider : Boolean)
  }
  class FrmNouveauRemplacant {
    +Praticien : Praticien
  }
  class FrmPraticiens {
    -Rechercher()
    -AfficherFiche(fiche)
  }
  class FrmMedicaments {
    -AfficherFiche(fiche)
  }
  class FrmMonActivite {
    -ChargerSynthese()
    -ChargerARevoir()
  }
  class FrmEquipe {
    -ChargerPeriode()
    -ChargerRapports()
    -ChargerARevoir()
  }
  class FrmEchantillons {
    -ChargerStock()
    -btnEnregistrer_Click()
  }
  class FrmFiche {
    +{static} CompteRendu(service, u, numero, auteur)
    +{static} SyntheseMembre(service, u, membre, debut, fin)
  }
  class RenduSynthese <<module>>
  class RenduARevoir <<module>>
  class FrmAdministration {
    -ChargerCollaborateurs()
    -ChargerPortefeuille()
    -ChargerJournal()
    -Operer(operation, rafraichir)
  }
  class FrmFormulaire {
    +Validation : Func<Task<ResultatOperation>>
    +Resultat : ResultatOperation
    +AjouterTexte / AjouterListe / AjouterDate
    +AjouterNombre / AjouterCase / AjouterNote
  }
  class FrmMessagerie
  class FrmNouveauMessage
  class GraphiqueBarres {
    +DefinirDonnees(donnees)
  }
  class TuileIndicateur
  class PanneauFiche {
    +AjouterTitre(texte)
    +AjouterBadge(texte, fond, encre)
    +AjouterSection(texte)
    +AjouterTableau(colonnes, lignes)
  }
  class Theme <<module>>
  class LibellesModules <<module>>
}

package "GSB.CR.Metier" {
  class FabriqueServices {
    +{static} DepuisConfiguration() : FabriqueServices
    +Authentification() : ServiceAuthentification
    +Rapports() : ServiceRapports
  }
  class ServiceAuthentification {
    +Connecter(login, motDePasse) : ResultatConnexion
    +ChangerMotDePasse(...) : List<String>
  }
  class ServiceRapports {
    +{static} AnneesConsultation : Integer = 3
    +MesRapports(u) : List<RapportResume>
    +NouveauRapport(u) : RapportVisite
    +Charger(u, numero) : RapportVisite
    +Enregistrer(u, rapport, valider, debutSaisie) : ResultatEnregistrement
    +SupprimerBrouillon(u, numero)
    +Portefeuille(u) : List<Praticien>
    +Motifs() / Medicaments() / TypesPraticien()
    +CreerRemplacant(p) : List<String>
  }
  class ServiceConsultation {
    +RechercherPraticiens(u, texte, monPortefeuille, inactifs)
    +FichePraticien(u, numero) : FichePraticien
    +Medicaments(u) : List<Medicament>
    +FicheMedicament(u, depot) : FicheMedicament
  }
  class ServiceActivite {
    +PeriodesPredefinies() : List<Periode>
    +MaSynthese(u, debut, fin) : SyntheseActivite
    +PraticiensARevoir(u) : List<PraticienARevoir>
    +{static} CompleterMois(mois, debut, fin)
    +{static} Prioriser(praticiens, aujourdhui)
  }
  class ServiceEquipe {
    +PerimetreDe(u) : Perimetre
    +Synthese(u, debut, fin) : SyntheseActivite
    +ActiviteParMembre(u, debut, fin)
    +SyntheseMembre(u, matricule, debut, fin)
    +RapportsEquipe(u) : List<RapportResume>
    +ChargerRapport(u, numero) : RapportVisite
    +PraticiensARevoir(u)
  }
  class ServiceEchantillons {
    +{static} PeutSaisir(u) : Boolean
    +Stock(u, mois, seulementLesEcarts)
    +EnregistrerDotation(u, matricule, depot, mois, quantite)
    +SupprimerDotation(u, matricule, depot, mois)
  }
  class Perimetres {
    +{static} DeLEquipe(u) : Perimetre
    +{static} ControlerPeriode(debut, fin, aujourdhui)
  }
  class ServiceMessagerie {
    +BoiteDeReception(u) / MessagesEnvoyes(u)
    +Lire(u, id) : MessageDetaille
    +Envoyer(u, objet, contenu, destinataires)
    +{static} Groupes(annuaire, u)
  }
  class ServiceAdministration {
    +Collaborateurs(u) / Affectations(u, matricule)
    +CreerCollaborateur(u, c, affectation) : ResultatOperation
    +ChangerAffectation(u, matricule, nouvelle, dateEffet)
    +EnregistrerDepart(u, matricule, date)
    +ReinitialiserMotDePasse(u, matricule)
    +DefinirVerrouillage(u, matricule, verrouille)
    +AttribuerPraticiens(u, numeros, matricule)
    +TransfererPortefeuille(u, de, vers)
    +EnregistrerPraticien(u, p) / ModifierMedicament(...)
    +CreerMotif(...) / ModifierMotif(...)
    +Journal(u, debut, fin, texte, echecs)
  }
  class ResultatOperation {
    +Erreurs : List<String>
    +Message : String
    +MotDePasseProvisoire : String
    +Reussi : Boolean
  }
  class GenerateurMotDePasse {
    +{static} Generer(longueur = 12) : String
  }
  class Periodicite {
    +{static} MoisMinimum = 6
    +{static} MoisMaximum = 8
    +{static} Evaluer(derniere, aujourdhui) : EtatPeriodicite
  }
  class ValidateurRapport {
    +{static} Verifier(rapport, aujourdhui) : List<String>
  }
  class ResultatEnregistrement {
    +Numero : Integer
    +Erreurs : List<String>
    +Reussi : Boolean
  }
  class ResultatConnexion
  class ErreurMetierException
  class HacheurMotDePasse
  class PolitiqueMotDePasse
  class Autorisations {
    +{static} PeutAcceder(p, m) : Boolean
  }
  enum ModuleApplication
  enum StatutConnexion
}

package "GSB.CR.Donnees" {
  abstract class DaoOracle {
    #Executer(message, traitement)
    #ExecuterTransaction(message, traitement)
    #Lister(message, sql, parametrer, lire)
  }
  interface ICollaborateurDao
  interface IRapportDao {
    +ListerParAuteur(matricule, depuis)
    +Charger(numero) : RapportVisite
    +Creer(rapport) : Integer
    +Modifier(rapport)
    +SupprimerBrouillon(numero) : Boolean
    +AjouterSessionSaisie(numero, matricule, debut, fin)
  }
  interface IReferentielDao {
    +ListerPortefeuille(matricule)
    +RechercherPraticiens(debut, maximum)
    +TrouverPraticien(numero)
    +CreerPraticien(p) : Integer
    +ListerMedicaments() / ListerMotifs()
  }
  interface IConsultationDao {
    +RechercherPraticiens(texte, matricule, inactifs, maximum)
    +ChargerFichePraticien(numero) : FichePraticien
    +ChargerFicheMedicament(depot) : FicheMedicament
  }
  class ConsultationDao
  interface IActiviteDao {
    +ChargerSynthese(matricule, debut, fin) : SyntheseActivite
  }
  class ActiviteDao
  interface IEquipeDao {
    +ListerMembres(perimetre) : List<MembreEquipe>
  }
  class EquipeDao
  interface IEchantillonDao {
    +Stock(perimetre, mois) : List<LigneStock>
    +EnregistrerDotation(...)
    +SupprimerDotation(...)
  }
  class EchantillonDao
  interface IAdministrationDao {
    +ListerCollaborateurs() / ListerAffectations(matricule)
    +CreerCollaborateur(c, affectation, hache)
    +ChangerAffectation(matricule, nouvelle, dateEffet)
    +AttribuerPraticiens(numeros, matricule, date)
    +TransfererPortefeuille(de, vers, date)
    +ListerJournal(debut, fin, texte, echecs)
  }
  class AdministrationDao
  interface IMessagerieDao
  class MessagerieDao
  class SqlPerimetre <<module>> {
    +Condition(colonne, perimetre) : String
  }
  class CollaborateurDao
  class RapportDao
  class ReferentielDao
  class ConnexionOracle {
    +Ouvrir() : OracleConnection
  }
  class ConfigurationOracle
  class AccesDonneesException
}

package "GSB.CR.Modeles" {
  class Collaborateur
  class Affectation
  class UtilisateurConnecte
  enum Profil
  class RapportVisite {
    +Numero : Integer [0..1]
    +MatriculeAuteur : String
    +NumeroPraticien : Integer [0..1]
    +NumeroRemplacant : Integer [0..1]
    +DateVisite : Date [0..1]
    +CodeMotif : String
    +PrecisionMotif : String
    +Bilan : String
    +CoefConfiance : Integer [0..1]
    +DateProchaineVisite : Date [0..1]
    +Etat : EtatRapport
    +ProduitsPresentes : List<String>
    +EstNouveau : Boolean
  }
  class RapportResume
  class EchantillonOffert {
    +DepotLegal : String
    +Quantite : Integer
  }
  enum EtatRapport {
    Brouillon
    Valide
  }
  class Praticien
  class TypePraticien
  class Medicament
  class FichePraticien
  class SyntheseActivite
  class Perimetre {
    +Type : TypePerimetre
    +Code : String
  }
  enum TypePerimetre {
    Collaborateur
    Region
    Secteur
  }
  class MembreEquipe
  class ActiviteMembre
  class LigneStock {
    +Attribue : Integer
    +Distribue : Integer
    +Ecart : Integer
  }
  class PraticienARevoir
  class Periode
  class FicheMedicament
  class PraticienResume
  enum EtatPeriodicite {
    AJour
    ARevoirBientot
    ARevoir
    JamaisVisite
  }
  class FicheCollaborateur {
    +TaillePortefeuille : Integer
  }
  class Region
  class Secteur
  class EntreeJournal {
    +DateHeure : DateTime
    +LoginSaisi : String
    +Succes : Boolean
  }
  class Motif {
    +{static} CodeAutre = "AUTRE"
  }
}

class "Oracle — schéma GSB" as BDD <<base de données>>

' --- IHM
Program ..> FabriqueServices : crée
Program ..> FrmConnexion
Program ..> FrmAccueil
FrmAccueil *-- "0..*" TuileModule
FrmAccueil ..> FrmMesComptesRendus : ouvre
FrmMesComptesRendus ..> FrmCompteRendu : ouvre
FrmCompteRendu ..> FrmNouveauRemplacant : ouvre
FrmConnexion --> ServiceAuthentification
FrmMesComptesRendus --> ServiceRapports
FrmCompteRendu --> ServiceRapports
FrmNouveauRemplacant --> ServiceRapports
FrmAccueil ..> FrmPraticiens : ouvre
FrmAccueil ..> FrmMedicaments : ouvre
FrmPraticiens --> ServiceConsultation
FrmAccueil ..> FrmMonActivite : ouvre
FrmMonActivite --> ServiceActivite
FrmAccueil ..> FrmEquipe : ouvre
FrmAccueil ..> FrmEchantillons : ouvre
FrmEquipe --> ServiceEquipe
FrmEquipe ..> FrmFiche : ouvre
FrmEchantillons --> ServiceEchantillons
FrmAccueil ..> FrmMessagerie : ouvre
FrmMessagerie --> ServiceMessagerie
FrmMessagerie ..> FrmNouveauMessage : ouvre
FrmNouveauMessage --> ServiceMessagerie
FrmAccueil ..> FrmAdministration : ouvre
FrmAdministration --> ServiceAdministration
FrmAdministration ..> FrmFormulaire : ouvre
FrmAdministration *-- PanneauFiche
FrmFormulaire ..> ResultatOperation
FrmFiche ..> ServiceEquipe
FrmMonActivite ..> RenduSynthese
FrmEquipe ..> RenduSynthese
FrmEquipe ..> RenduARevoir
FrmMonActivite --> ServiceRapports
FrmMonActivite ..> FrmCompteRendu : saisie directe
FrmMonActivite *-- PanneauFiche
PanneauFiche o-- GraphiqueBarres
PanneauFiche o-- TuileIndicateur
FrmMedicaments --> ServiceConsultation
FrmPraticiens *-- PanneauFiche
FrmMedicaments *-- PanneauFiche
FrmAccueil ..> Autorisations
TuileModule ..> LibellesModules

' --- Métier
FabriqueServices ..> ServiceAuthentification : crée
FabriqueServices ..> ServiceRapports : crée
FabriqueServices ..> ServiceConsultation : crée
FabriqueServices ..> ServiceActivite : crée
FabriqueServices ..> ServiceEquipe : crée
FabriqueServices ..> ServiceEchantillons : crée
FabriqueServices ..> ServiceMessagerie : crée
ServiceMessagerie --> IMessagerieDao
FabriqueServices ..> ServiceAdministration : crée
ServiceAdministration --> IAdministrationDao
ServiceAdministration --> IReferentielDao
ServiceAdministration --> IConsultationDao
ServiceAdministration ..> GenerateurMotDePasse
ServiceAdministration ..> HacheurMotDePasse
ServiceAdministration ..> ResultatOperation : produit
ServiceEquipe --> IActiviteDao
ServiceEquipe --> IRapportDao
ServiceEquipe --> IEquipeDao
ServiceEquipe ..> Perimetres
ServiceEchantillons --> IEchantillonDao
ServiceEchantillons --> IEquipeDao
ServiceEchantillons ..> Perimetres
ServiceActivite --> IActiviteDao
ServiceActivite --> IConsultationDao
ServiceActivite ..> Periodicite
ServiceConsultation --> IConsultationDao
ServiceConsultation --> IReferentielDao
ServiceConsultation ..> Periodicite
Periodicite ..> EtatPeriodicite
ServiceAuthentification --> ICollaborateurDao
ServiceAuthentification ..> HacheurMotDePasse
ServiceAuthentification ..> PolitiqueMotDePasse
ServiceAuthentification ..> ResultatConnexion
ResultatConnexion --> StatutConnexion
ServiceRapports --> IRapportDao
ServiceRapports --> IReferentielDao
ServiceRapports ..> ValidateurRapport
ServiceRapports ..> Autorisations
ServiceRapports ..> ResultatEnregistrement : produit
ServiceRapports ..> ErreurMetierException : lève
Autorisations ..> ModuleApplication

' --- Données
DaoOracle <|-- CollaborateurDao
DaoOracle <|-- RapportDao
DaoOracle <|-- ReferentielDao
DaoOracle <|-- ConsultationDao
DaoOracle <|-- ActiviteDao
DaoOracle <|-- EquipeDao
DaoOracle <|-- EchantillonDao
DaoOracle <|-- MessagerieDao
MessagerieDao ..|> IMessagerieDao
DaoOracle <|-- AdministrationDao
AdministrationDao ..|> IAdministrationDao
EquipeDao ..|> IEquipeDao
EchantillonDao ..|> IEchantillonDao
DaoOracle ..> SqlPerimetre
Perimetre --> TypePerimetre
ActiviteDao ..|> IActiviteDao
ConsultationDao ..|> IConsultationDao
CollaborateurDao ..|> ICollaborateurDao
RapportDao ..|> IRapportDao
ReferentielDao ..|> IReferentielDao
DaoOracle --> ConnexionOracle
DaoOracle ..> AccesDonneesException : lève
ConnexionOracle ..> ConfigurationOracle
ConnexionOracle ..> BDD : ODP.NET\nTCP 1521

' --- Modèles
UtilisateurConnecte --> Collaborateur
UtilisateurConnecte --> Affectation
Affectation --> Profil
RapportVisite *-- "0..*" EchantillonOffert
RapportVisite --> EtatRapport
RapportResume --> EtatRapport
Praticien ..> TypePraticien
FicheCollaborateur --> Collaborateur
FicheCollaborateur --> "0..1" Affectation : en cours

note bottom of DaoOracle
  Base commune : connexion, transactions
  (tout ou rien), traduction des erreurs Oracle.
end note
note bottom of IRapportDao
  Interfaces : la couche Métier est testée
  avec des DAO en mémoire (sans Oracle).
end note
@enduml
